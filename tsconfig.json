{
    "compilerOptions":  {
                            "target":  "esnext",
                            "module":  "esnext",
                            "moduleResolution":  "bundler",
                            "jsx":  "react-native",
                            "strict":  true,
                            "allowJs":  false,
                            "resolveJsonModule":  true,
                            "isolatedModules":  true,
                            "skipLibCheck":  true,
                            "noEmit":  true,
                            "baseUrl":  ".",
                            "paths":  {
                                          "@/*":  [
                                                      "./*"
                                                  ]
                                      },
                            "ignoreDeprecations":  "6.0"
                        },
    "include":  [
                    "app",
                    "src",
                    "components",
                    "lib",
                    ".expo/types/**/*.ts",
                    "expo-env.d.ts"
                ],
    "exclude":  [
                    "node_modules"
                ],
    "extends":  "expo/tsconfig.base"
}
